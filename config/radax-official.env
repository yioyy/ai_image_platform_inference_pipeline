RADX_API_HOST=localhost
RADX_API_PORT=4000
# Optional override:
# RADX_API_URL=http://localhost:4000/v1/ai-inference/inference-complete

# ---- Runtime / paths ----
RADX_CODE_ROOT=/home/david/pipeline/chuan/code

RADX_PROCESS_ROOT=/home/david/pipeline/chuan/process
