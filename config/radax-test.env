## Radax test environment config (deploy/radax-test)
## Format: KEY=VALUE (bash: `set -a; source radax-test.env; set +a`)

# ---- API ----
RADX_API_HOST=localhost
RADX_API_PORT=24000
# Optional override (if set, host/port are ignored):
# RADX_API_URL=http://localhost:24000/v1/ai-inference/inference-complete

# ---- Runtime / paths ----
# Base checkout (repo root)
RADX_CODE_ROOT=/home/david/pipeline/chuan/radax

# Data roots
RADX_PROCESS_ROOT=/home/david/pipeline/chuan/process
RADX_JSON_ROOT=/home/david/pipeline/chuan/json
RADX_LOG_ROOT=/home/david/pipeline/chuan/log

# nnU-Net models
RADX_BRAIN_MODEL=/home/david/pipeline/chuan/radax/nnUNet/nnUNet_results/Dataset134_DeepMRABrain/nnUNetTrainer__nnUNetPlans__3d_fullres
RADX_VESSEL_MODEL=/home/david/pipeline/chuan/radax/nnUNet/nnUNet_results/Dataset135_DeepMRAVessel/nnUNetTrainer__nnUNetPlans__3d_fullres
RADX_ANEURYSM_MODEL=/home/david/pipeline/chuan/radax/nnUNet/nnUNet_results/Dataset080_DeepAneurysm/nnUNetTrainer__nnUNetPlans__3d_fullres

